<Window x:Class="PolicyLab.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Mẫu kiểm tra quyền — E02a" Width="1100" Height="820" MinWidth="760" MinHeight="600"
 FontFamily="Segoe UI" FontSize="16" Background="#F5F6F8" Foreground="#202B38">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20">
   <TextBlock Text="KIỂM CHỨNG / E02a" Foreground="#155E52" FontSize="13" FontWeight="SemiBold"/>
   <TextBlock Text="Chỉ nhận nội dung được phép" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,8"/>
   <TextBlock Text="DỮ LIỆU GIẢ · Không đọc màn hình, không điều khiển máy, không kết nối AI hay Internet."/>
  </StackPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Chọn tình huống" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <ListBox x:Name="CaseList" ItemsSource="{Binding Cases}" SelectedItem="{Binding SelectedScenario}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
     AutomationProperties.Name="Danh sách tình huống giả" BorderThickness="0" Background="White">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8">
      <TextBlock Text="{Binding Id}" FontSize="13" Foreground="#155E52" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding Title}" MaxWidth="246" Margin="0,4,0,0"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="0,0,12,0">
     <TextBlock Text="{Binding SelectedScenario.Title}" FontSize="22" FontWeight="SemiBold"/>
     <TextBlock Text="{Binding Expected}" Margin="0,8,0,16"/>
     <TextBlock Text="Điều kiện giả của nguồn A" FontWeight="SemiBold" Margin="0,0,0,12"/>
     <WrapPanel>
      <CheckBox Content="Trình duyệt: Đọc" IsChecked="{Binding AppRead}"/>
      <CheckBox Content="Website: Đọc" IsChecked="{Binding SiteRead}"/>
      <CheckBox Content="Điều khiển (giả)" IsChecked="{Binding Control}" ToolTip="Cần bật Đọc ở cả hai tầng; không điều khiển máy thật."/>
     </WrapPanel>
     <TextBlock Text="{Binding SourceSummary}" Margin="0,0,0,12"/>
     <Border Background="#E7F1EE" Padding="16" CornerRadius="8" Margin="0,0,0,16">
      <StackPanel>
       <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding Explanation}" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>
     <WrapPanel>
      <Button Content="Áp dụng thay đổi mẫu" Command="{Binding ApplyChangeCommand}" ToolTip="Chỉ dùng khi tình huống có bước đổi quyền/nguồn giữa chừng."/>
      <Button Content="Tiếp tục kiểm tra" Command="{Binding CompleteCommand}" ToolTip="Chỉ dùng khi có lượt đang chờ."/>
      <Button Content="Sửa vùng giả thành an toàn" Command="{Binding RepairCommand}"/>
     </WrapPanel>
     <TextBlock Text="Đầu vào bộ nhận thực tế" FontWeight="SemiBold" Margin="0,8,0,8"/>
     <TextBox Text="{Binding Received, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled" MinHeight="64" MaxHeight="120" Padding="12" AutomationProperties.Name="Đầu vào bộ nhận"/>
     <TextBlock Text="{Binding GeometrySummary}" Margin="0,8,0,16"/>
     <TextBlock Text="Chẩn đoán / kết quả kiểm chứng" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <TextBox Text="{Binding Report, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Disabled" MinHeight="100" MaxHeight="260" Padding="12" AutomationProperties.Name="Báo cáo kết quả"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,20,0,0">
   <WrapPanel>
    <Button Content="Kiểm tra tình huống" Command="{Binding StartCommand}" Background="#155E52" Foreground="White"/>
    <Button Content="Thử đọc lại" Command="{Binding RetryCommand}"/>
    <Button Content="Hủy lượt kiểm tra" Command="{Binding CancelCommand}" ToolTip="Chỉ dùng khi có lượt đang chờ."/>
    <Button Content="{Binding ObservationLabel}" Command="{Binding ObservationCommand}"/>
    <Button Content="{Binding VisibilityLabel}" Command="{Binding VisibilityCommand}"/>
    <Button Content="Đặt lại tình huống" Command="{Binding ResetCommand}"/>
    <Button Content="Chạy toàn bộ kiểm chứng" Command="{Binding RunAllCommand}"/>
   </WrapPanel>
   <TextBlock Text="Mẫu kiểm tra quy tắc. Đạt tại đây chưa chứng minh khả năng đọc màn hình thật hoặc tích hợp Unity." FontSize="13"/>
  </StackPanel>
 </Grid>
</Window>
